{
  "plan": "takeover",
  "description": "Engine scene integration budgets: 1280x720 idle >= 110 fps and p95 <= 10 ms, GPU <= 3.0 ms at 1080p, draws <= 400, worst frame across the shot + crater edit <= 50 ms, labels within 4 px of worldToScreen, 0 console/page/validation/pipeline errors. Timing checks are warn-unless-perf (they FAIL only in capture.ts --perf --repeat 3 --min runs; single runs on a shared machine swing 2x).",
  "tolerance": 0.15,
  "checks": [
    { "id": "drive-ok", "path": "jobs.takeover-drive.ok", "equals": true, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "perf-ok", "path": "jobs.takeover-perf.ok", "equals": true, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "closeup-ok", "path": "jobs.takeover-closeup.ok", "equals": true, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "overview-ok", "path": "jobs.takeover-overview.ok", "equals": true, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "page-errors", "path": "jobs.takeover-drive.pageErrors", "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "console-errors", "path": "jobs.takeover-drive.consoleErrors", "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "closeup-console-errors", "path": "jobs.takeover-closeup.consoleErrors", "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "overview-console-errors", "path": "jobs.takeover-overview.consoleErrors", "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "http-errors", "path": "jobs.takeover-drive.httpErrors", "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "validation-errors", "path": "shots.takeover-drive-impact.telemetry.performance.validationErrors", "max": 0, "gate": true, "note": "uncaptured WebGPU errors counted by the engine context", "stream": "W1-ENG-SCENE" },
    { "id": "pipeline-errors", "path": "shots.takeover-drive-impact.telemetry.performance.compileErrors", "max": 0, "gate": true, "note": "create*PipelineAsync failures (the ?shaderCheck equivalent)", "stream": "W1-ENG-SCENE" },
    { "id": "planet-pipeline", "path": "shots.takeover-drive-ready.telemetry.performance.planetPipeline", "equals": "ready", "note": "the per-seed terrain pipeline (terrainPlanetWGSL facet) replaced the fallback", "stream": "W1-ENG-SCENE" },
    { "id": "idle-fps", "path": "shots.takeover-perf-idle.telemetry.performance.fps", "min": 110, "severity": "warn-unless-perf", "stream": "W1-ENG-SCENE" },
    { "id": "idle-frame-p95-ms", "path": "shots.takeover-perf-idle.frames.frameMs.p95", "max": 10, "severity": "warn-unless-perf", "note": "rAF deltas over 240 frames at 1280x720", "stream": "W1-ENG-SCENE" },
    { "id": "idle-draws", "path": "shots.takeover-perf-idle.telemetry.performance.draws", "max": 400, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "closeup-draws", "path": "shots.takeover-closeup-rear.telemetry.performance.draws", "max": 400, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "gpu-1080p-ms", "path": "shots.takeover-gpu1080-gameplay.telemetry.performance.gpuMs", "max": 3.0, "severity": "warn-unless-perf", "note": "rolling per-pass timestamp sum, default boom-17 view at 1920x1080, lighting v0", "stream": "W1-ENG-SCENE" },
    { "id": "gpu-1080p-planet-ms", "path": "shots.takeover-gpu1080-planet.telemetry.performance.gpuMs", "max": 3.0, "severity": "warn-unless-perf", "note": "planet view (most pages on screen) at 1920x1080", "stream": "W1-ENG-SCENE" },
    { "id": "gpu-1080p-closeup-ms", "path": "shots.takeover-closeup-orbit.telemetry.performance.gpuMs", "max": 3.0, "severity": "warn-unless-perf", "note": "boom-6 close-up at 1920x1080", "stream": "W1-ENG-SCENE" },
    { "id": "gpu1080-ok", "path": "jobs.takeover-gpu1080.ok", "equals": true, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "worst-edit-frame-ms", "path": "shots.takeover-perf-edit.frames.frameMs.max", "max": 50, "severity": "warn-unless-perf", "note": "longest rAF delta across the shot, the impact and the crater edit", "stream": "W1-ENG-SCENE" },
    { "id": "labels-px", "path": "jobs.takeover-drive.evals.labels.result.maxError", "max": 4, "gate": true, "note": "DOM label bottom-centre vs worldToScreen(anchor) of the drawn frame", "stream": "W1-ENG-SCENE" },
    { "id": "labels-shown", "path": "jobs.takeover-drive.evals.labels.result.labels", "min": 1, "stream": "W1-ENG-SCENE" },
    { "id": "overlay-consumed", "path": "shots.takeover-drive-aimed.telemetry.performance.overlays.consumed", "equals": true, "gate": true, "note": "a pass after the forward overlay pass reads its postColor output (bloom and composite), so the ribbon and rings reach the screen", "stream": "W1-ENG-SCENE" },
    { "id": "overlay-route", "path": "shots.takeover-drive-aimed.telemetry.performance.overlays.route", "equals": "overlay", "note": "plan 4.5: overlays after TAA/DOF, drawn into the post input (postColor) that bloom and composite read; a gate since the integrator's CC-013 fix (was a warn while the post chain read taaColor and the overlays fell back to before TAA)", "stream": "W1-ENG-SCENE", "gate": true },
    { "id": "ribbon-drawn", "path": "shots.takeover-drive-aimed.telemetry.performance.overlays.ribbonPoints", "min": 2, "gate": true, "note": "the aim preview reaches the overlay facet", "stream": "W1-ENG-SCENE" },
    { "id": "shockwave-emitted", "path": "shots.takeover-drive-impactframe.telemetry.performance.shockwaves.emitted", "min": 1, "gate": true, "note": "a three-dimensional pressure front was emitted by the impact frame (cumulative count survives its short lifetime; radar/aiming rings cannot satisfy this gate)", "stream": "W1-ENG-SCENE" },
    { "id": "labels-projection-px", "path": "jobs.takeover-drive.evals.labels.result.refError", "max": 1, "gate": true, "note": "engine.project vs an independent three.js projection of the math camera the engine rig is built from", "stream": "W1-ENG-SCENE" },
    { "id": "impact-flash", "path": "shots.takeover-drive-impactframe.telemetry.performance.flashes", "min": 1, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "crater-committed", "path": "shots.takeover-drive-impact.telemetry.terrainVersion", "min": 2, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "pending-retired", "path": "shots.takeover-drive-impact.telemetry.performance.pendingCuts", "equals": 0, "note": "the commit retired the pending crater", "stream": "W1-ENG-SCENE" },
    { "id": "track-stamps", "path": "shots.takeover-closeup-rear.telemetry.performance.footprintCount", "min": 1, "note": "SMC track stamps written while driving", "stream": "W1-ENG-SCENE" },
    { "id": "pages-culled", "path": "shots.takeover-perf-idle.telemetry.performance.pagesDrawn", "max": 200, "note": "CPU frustum + horizon culling draws a subset of the planet's pages", "stream": "W1-ENG-SCENE" },
    { "id": "no-nan-blotches", "image": { "shot": "takeover-closeup-rear", "metric": "nanBlocks.total" }, "max": 0, "gate": true, "stream": "W1-ENG-SCENE" },
    { "id": "no-nan-blotches-impact", "image": { "shot": "takeover-drive-impactframe", "metric": "nanBlocks.total" }, "max": 0, "gate": true, "stream": "W1-ENG-SCENE" }
  ]
}
