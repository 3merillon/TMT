{
  "plan": "lighting",
  "description": "Sun shadows, atmosphere/sky, sky light, lighting and basic post on the engine sandbox look scene. Image and probe checks always gate; GPU pass times are warn-unless-perf (they FAIL only in a --perf --repeat 3 --min run; the perf job loads the GPU with ?load=6 so it reaches gameplay clocks).",
  "tolerance": 0.15,
  "checks": [
    {"id": "temperate-ok", "path": "jobs.lighting-temperate.ok", "equals": true, "stream": "W1-ENG-LOOK"},
    {"id": "temperate-page-errors", "path": "jobs.lighting-temperate.pageErrors", "max": 0, "gate": true, "stream": "W1-ENG-LOOK"},
    {"id": "temperate-console-errors", "path": "jobs.lighting-temperate.consoleErrors", "max": 0, "gate": true, "stream": "W1-ENG-LOOK"},
    {"id": "temperate-sky-not-black", "image": {"shot": "lighting-temperate-day", "rect": [0, 0, 1, 0.15], "metric": "lumaMean"}, "min": 0.12, "gate": true, "note": "top-15% band mean luma > 0.12 (the diorama backdrop)", "stream": "W1-ENG-LOOK"},
    {"id": "temperate-boom6-sky-not-black", "image": {"shot": "lighting-temperate-boom6", "rect": [0, 0, 1, 0.15], "metric": "lumaMean"}, "min": 0.12, "gate": true, "stream": "W1-ENG-LOOK"},
    {"id": "temperate-terminator", "path": "jobs.lighting-temperate.evals.term.result.ratio", "max": 0.15, "gate": true, "note": "overview: night-side / day-side planet luma (engine.project-anchored 40 px rects)", "stream": "W1-ENG-LOOK"},
    {"id": "temperate-tank-on-ground", "path": "jobs.lighting-temperate.evals.tank.result.ratio", "max": 0.65, "note": "ground in the hull shadow / open ground 1.5 u beyond (engine.project-anchored)", "stream": "W1-ENG-LOOK"},
    {"id": "temperate-no-acne", "path": "jobs.lighting-temperate.evals.acne.result.ratio", "max": 1.2, "gate": true, "note": "lit flat ground luma std, shadows on / shadows (maps + contact) off", "stream": "W1-ENG-LOOK"},
    {"id": "temperate-day-no-nan", "image": {"shot": "lighting-temperate-day", "metric": "nanBlocks.total"}, "max": 0, "gate": true, "stream": "W1-ENG-LOOK"},
