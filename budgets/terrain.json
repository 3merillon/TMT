{
  "plan": "terrain",
  "description": "Five resident crater edits on seed 7 (?residentCheck=1). Enqueue->ready targets: p50 <= 90 ms, p95 <= 150 ms; worst frame while an edit is in flight <= 33 ms (two 60 Hz frames; rAF reads 33.3-33.4), over all five craters including the first. The terrain-no-fx job isolates terrain-attributable frames. Warm startup <= 4.0 s uses an IndexedDB page-cache hit and reload. Timing checks FAIL only in a perf run (capture.ts --perf --repeat 3 --min; severity warn-unless-perf). Historical coarse bounds remain alongside the stricter targets. The \"bench\" entries are evaluated by scripts/bench-terrain.ts (serial Node, 20% tolerance).",
  "tolerance": 0.15,
  "checks": [
    { "id": "terrain-ok", "path": "jobs.terrain-resident.ok", "equals": true, "stream": "W0-TOOLS" },
    { "id": "page-errors", "path": "jobs.terrain-resident.pageErrors", "max": 0, "gate": true, "stream": "W0-TOOLS" },
    { "id": "console-errors", "path": "jobs.terrain-resident.consoleErrors", "max": 0, "gate": true, "stream": "W0-TOOLS" },
    { "id": "edits", "path": "jobs.terrain-resident.evals.edits.result.edits", "equals": 5, "stream": "W0-TOOLS" },
    { "id": "edit-p50-ms", "path": "jobs.terrain-resident.evals.edits.result.p50Ms", "max": 320, "severity": "warn-unless-perf", "note": "Historical enqueue->commit median bound.", "stream": "W0-TOOLS" },
    { "id": "edit-max-ms", "path": "jobs.terrain-resident.evals.edits.result.maxMs", "max": 932, "severity": "warn-unless-perf", "note": "Historical worst-edit bound, measured with compaction inside the edit.", "stream": "W0-TOOLS" },
    { "id": "edit-p50-gate1-ms", "path": "jobs.terrain-resident.evals.edits.result.p50Ms", "max": 90, "gate": true, "severity": "warn-unless-perf", "note": "Enqueue->ready p50 target.", "stream": "W1-TER" },
    { "id": "edit-p95-gate1-ms", "path": "jobs.terrain-resident.evals.edits.result.p95Ms", "max": 150, "gate": true, "severity": "warn-unless-perf", "note": "Enqueue->ready p95 target.", "stream": "W1-TER" },
    { "id": "ledger-error", "path": "jobs.terrain-resident.evals.edits.result.ledgerMaxAbs", "max": 1e-5, "gate": true, "note": "I7 volume ledger", "stream": "W0-TOOLS" },
    { "id": "seam-unpaired", "path": "jobs.terrain-resident.evals.edits.result.seamUnpaired", "equals": 0, "note": "I2 canonical boundaries", "stream": "W0-TOOLS" },
    { "id": "fallbacks", "path": "jobs.terrain-resident.evals.edits.result.fallbacks", "max": 0, "gate": true, "note": "exact-arrangement fallbacks during the edits", "stream": "W0-TOOLS" },
    { "id": "no-failure", "path": "jobs.terrain-resident.evals.edits.result.failure", "equals": null, "note": "I3: no resident failure recorded", "stream": "W0-TOOLS" },
    { "id": "worst-frame-crater-1-ms", "path": "shots.terrain-resident-crater-1.telemetry.performance.maxFrameMs", "max": 120, "severity": "warn-unless-perf", "note": "rolling 180-frame max around the first commit", "stream": "W0-TOOLS" },
    { "id": "worst-frame-crater-2-ms", "path": "shots.terrain-resident-crater-2.telemetry.performance.maxFrameMs", "max": 120, "severity": "warn-unless-perf", "stream": "W0-TOOLS" },
    { "id": "worst-frame-crater-3-ms", "path": "shots.terrain-resident-crater-3.telemetry.performance.maxFrameMs", "max": 120, "severity": "warn-unless-perf", "stream": "W0-TOOLS" },
    { "id": "worst-frame-crater-4-ms", "path": "shots.terrain-resident-crater-4.telemetry.performance.maxFrameMs", "max": 120, "severity": "warn-unless-perf", "stream": "W0-TOOLS" },
    { "id": "worst-frame-crater-5-ms", "path": "shots.terrain-resident-crater-5.telemetry.performance.maxFrameMs", "max": 120, "severity": "warn-unless-perf", "stream": "W0-TOOLS" },
    { "id": "no-nan-blotches", "image": { "shot": "terrain-resident-crater-5", "metric": "nanBlocks.total" }, "max": 0, "gate": true, "stream": "W0-TOOLS" },
    { "id": "readbacks-per-edit", "path": "jobs.terrain-resident.evals.edits.result.readbacksMax", "equals": 1, "note": "I8: one mapAsync per transaction", "stream": "W1-TER" },
    { "id": "submissions-per-edit", "path": "jobs.terrain-resident.evals.edits.result.submissionsMax", "equals": 1, "note": "one queue submission per transaction", "stream": "W1-TER" },
    { "id": "compactions-in-edits", "path": "jobs.terrain-resident.evals.edits.result.compactionsInEdits", "equals": 0, "note": "compaction only in idle maintenance()", "stream": "W1-TER" },
    { "id": "edit-worst-frame-ms", "path": "jobs.terrain-resident.evals.edits.result.worstFrameMaxMs", "max": 33.4, "gate": true, "severity": "warn-unless-perf", "note": "Worst frame from request to two frames after commit, across all five craters in the real game, including impact effects.", "stream": "W1-TER" },
    { "id": "edit-frames-measured", "path": "jobs.terrain-resident.evals.edits.result.framesMeasured", "equals": 5, "gate": true, "note": "every edit records its own in-flight worst frame (back-to-back edits included)", "stream": "W1-TER" },
    { "id": "edit-worst-frame-terrain-ms", "path": "jobs.terrain-no-fx.evals.edits.result.worstFrameMaxMs", "max": 33.4, "gate": true, "severity": "warn-unless-perf", "note": "terrain-attributable in-flight frames: the same five craters with the three.js explosion path stubbed while it exists, first crater included (8-9 ms per crater in a perf run)", "stream": "W1-TER" },
    { "id": "edit-frames-measured-terrain", "path": "jobs.terrain-no-fx.evals.edits.result.framesMeasured", "equals": 5, "gate": true, "stream": "W1-TER" },
    { "id": "edit-p95-terrain-ms", "path": "jobs.terrain-no-fx.evals.edits.result.p95Ms", "max": 150, "gate": true, "severity": "warn-unless-perf", "note": "Enqueue->ready p95 with explosion presentation isolated.", "stream": "W1-TER" },
    { "id": "no-fx-errors", "path": "jobs.terrain-no-fx.consoleErrors", "max": 0, "gate": true, "stream": "W1-TER" },
    { "id": "edit-longest-slice-ms", "path": "jobs.terrain-resident.evals.edits.result.longestSliceMaxMs", "max": 12, "severity": "warn-unless-perf", "note": "longest synchronous terrain stretch of an edit (4 ms slices; physics.stage static trimesh cooking is one call of up to ~12 ms)", "stream": "W1-TER" },
    { "id": "oracle-failures", "path": "jobs.terrain-resident.evals.oracle.result.failures", "equals": 0, "note": "idle global oracle: fine-graph connectivity, full seam audit, incremental boundary", "stream": "W1-TER" },
    { "id": "oracle-checked", "path": "jobs.terrain-resident.evals.oracle.result.checked", "min": 1, "gate": true, "stream": "W1-TER" },
    { "id": "warm-startup-ms", "path": "jobs.terrain-resident.timings.reloadReadyMs", "max": 4000, "gate": true, "severity": "warn-unless-perf", "note": "Reload with the IndexedDB page cache.", "stream": "W1-TER" },
    { "id": "warm-cache-hits", "path": "jobs.terrain-resident.evals.warm.result.cacheHits", "min": 1, "gate": true, "note": "the reload compiled nothing", "stream": "W1-TER" }
  ],
  "bench": [
    { "id": "bench-r2-p50-ms", "path": "series.r2.p50Ms", "max": 90, "note": "serial enqueue->commit median, r = 2.0", "stream": "W1-TER" },
    { "id": "bench-r2.6-p50-ms", "path": "series.r2_6.p50Ms", "max": 110, "note": "W1-TER acceptance: serial r = 2.6 median <= 110 ms (wave-0: 264-419)", "stream": "W1-TER" },
    { "id": "bench-r3.5-p50-ms", "path": "series.r3_5.p50Ms", "max": 200, "stream": "W1-TER" },
    { "id": "bench-r4.8-p50-ms", "path": "series.r4_8.p50Ms", "max": 300, "note": "W1-TER acceptance: serial r = 4.8 median <= 300 ms (wave-0: 855)", "stream": "W1-TER" },
    { "id": "bench-compactions-in-edits", "path": "maintenance.compactionsInEdits", "equals": 0, "note": "zero compactions inside edits", "stream": "W1-TER" },
    { "id": "bench-flatness", "path": "flatness.ratio", "max": 1.15, "note": "the same r = 2.6 probe (prepared and aborted) after / before 120+ craters elsewhere (tests/terrain-scaling.test.ts asserts it too)", "stream": "W1-TER" },
    { "id": "bench-ledger", "path": "series.r2_6.ledgerMaxAbs", "max": 1e-5, "gate": true, "stream": "W1-TER" },
    { "id": "bench-seams", "path": "series.r2_6.seamUnpaired", "equals": 0, "stream": "W1-TER" }
  ]
}
