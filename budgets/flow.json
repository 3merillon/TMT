{
  "plan": "flow",
  "description": "Front-end flow rubric: screens in order, no clipped panels, no dev chrome without ?dev, zero page/console errors, at 1280x720 and 390x844.",
  "tolerance": 0,
  "checks": [
    { "id": "flow-desktop-ok", "path": "jobs.flow-desktop.ok", "equals": true, "stream": "W1-SHELL" },
    { "id": "flow-desktop-page-errors", "path": "jobs.flow-desktop.pageErrors", "max": 0, "gate": true, "stream": "W1-SHELL" },
    { "id": "flow-desktop-console-errors", "path": "jobs.flow-desktop.consoleErrors", "max": 0, "gate": true, "stream": "W1-SHELL" },
    { "id": "flow-desktop-title-screen", "path": "shots.flow-desktop-title.telemetry.ui.screen", "equals": "title", "stream": "W1-SHELL" },
    { "id": "flow-desktop-setup-screen", "path": "shots.flow-desktop-setup.telemetry.ui.screen", "equals": "skirmish", "stream": "W1-SHELL" },
    { "id": "flow-desktop-match-screen", "path": "shots.flow-desktop-match.telemetry.ui.screen", "equals": "match", "stream": "W1-SHELL" },
    { "id": "flow-desktop-pause-screen", "path": "shots.flow-desktop-pause.telemetry.ui.screen", "equals": "pause", "stream": "W1-SHELL" },
    { "id": "flow-desktop-results-screen", "path": "shots.flow-desktop-results.telemetry.ui.screen", "equals": "results", "stream": "W1-SHELL" },
    { "id": "flow-desktop-route", "path": "jobs.flow-desktop.evals.route.result", "equals": ["boot", "title", "skirmish", "loading", "match", "pause", "results"], "note": "screens entered in order", "stream": "W1-SHELL" },
    { "id": "flow-desktop-no-dev-chrome", "path": "jobs.flow-desktop.evals.devbar.result", "equals": true, "note": "no developer chrome without ?dev", "stream": "W1-SHELL" },
    { "id": "flow-desktop-unclipped-title", "path": "jobs.flow-desktop.evals.clip-title.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-desktop-unclipped-setup", "path": "jobs.flow-desktop.evals.clip-setup.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-desktop-unclipped-match", "path": "jobs.flow-desktop.evals.clip-match.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-desktop-unclipped-pause", "path": "jobs.flow-desktop.evals.clip-pause.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-desktop-unclipped-results", "path": "jobs.flow-desktop.evals.clip-results.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-desktop-match-ready", "path": "shots.flow-desktop-match.telemetry.ready", "equals": true, "stream": "W1-SHELL" },
    { "id": "flow-desktop-match-nan", "image": {"shot": "flow-desktop-match", "metric": "nanBlocks.total"}, "max": 0, "gate": true, "stream": "W1-SHELL" },
    { "id": "flow-phone-ok", "path": "jobs.flow-phone.ok", "equals": true, "stream": "W1-SHELL" },
    { "id": "flow-phone-page-errors", "path": "jobs.flow-phone.pageErrors", "max": 0, "gate": true, "stream": "W1-SHELL" },
    { "id": "flow-phone-console-errors", "path": "jobs.flow-phone.consoleErrors", "max": 0, "gate": true, "stream": "W1-SHELL" },
    { "id": "flow-phone-title-screen", "path": "shots.flow-phone-title.telemetry.ui.screen", "equals": "title", "stream": "W1-SHELL" },
    { "id": "flow-phone-setup-screen", "path": "shots.flow-phone-setup.telemetry.ui.screen", "equals": "skirmish", "stream": "W1-SHELL" },
    { "id": "flow-phone-match-screen", "path": "shots.flow-phone-match.telemetry.ui.screen", "equals": "match", "stream": "W1-SHELL" },
    { "id": "flow-phone-pause-screen", "path": "shots.flow-phone-pause.telemetry.ui.screen", "equals": "pause", "stream": "W1-SHELL" },
    { "id": "flow-phone-results-screen", "path": "shots.flow-phone-results.telemetry.ui.screen", "equals": "results", "stream": "W1-SHELL" },
    { "id": "flow-phone-route", "path": "jobs.flow-phone.evals.route.result", "equals": ["boot", "title", "skirmish", "loading", "match", "pause", "results"], "note": "screens entered in order", "stream": "W1-SHELL" },
    { "id": "flow-phone-no-dev-chrome", "path": "jobs.flow-phone.evals.devbar.result", "equals": true, "note": "no developer chrome without ?dev", "stream": "W1-SHELL" },
    { "id": "flow-phone-unclipped-title", "path": "jobs.flow-phone.evals.clip-title.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-phone-unclipped-setup", "path": "jobs.flow-phone.evals.clip-setup.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-phone-unclipped-match", "path": "jobs.flow-phone.evals.clip-match.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-phone-unclipped-pause", "path": "jobs.flow-phone.evals.clip-pause.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-phone-unclipped-results", "path": "jobs.flow-phone.evals.clip-results.result", "max": 0, "gate": true, "note": "visible panels inside the viewport, no cut-off content", "stream": "W1-SHELL" },
    { "id": "flow-phone-match-ready", "path": "shots.flow-phone-match.telemetry.ready", "equals": true, "stream": "W1-SHELL" },
    { "id": "flow-phone-match-nan", "image": {"shot": "flow-phone-match", "metric": "nanBlocks.total"}, "max": 0, "gate": true, "stream": "W1-SHELL" }
  ]
}
