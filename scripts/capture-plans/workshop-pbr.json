{
  "name": "workshop-pbr",
  "out": "artifacts/workshop-pbr-closeups",
  "jobs": [{
    "name": "authored-props",
    "url": "/play.html",
    "size": "1920x1080",
    "wait": "selector:#title-workshop",
    "settle": 100,
    "timeout": 120000,
    "probe": "window.__tmtWorkshop?.snapshot()",
    "keys": [
      "click:#title-workshop",
      "waitfor:window.__tmtWorkshop?.ready && !document.querySelector('.ws-loading')",
      "wait:1800",
      "eval@shaderCheck:window.__tmtWorkshop.shaderCheck()",
      "shot:hero",
      "eval:(() => { window.__workshopCaptureRuns = [window.__tmtWorkshop]; document.querySelector('.ws-overlay').style.visibility='hidden'; const e=window.__tmtWorkshop.engine; window.__originalWorkshopFrame=e.frame.bind(e); e.frame = input => window.__originalWorkshopFrame({...input, camera:{position:[2.4,2.6,-1.7],target:[5.06,1.95,-5.73],up:[0,1,0],fovY:48*Math.PI/180},focus:{world:[5.06,1.95,-5.73],distance:4.9,tilt:0}}); })()",
      "wait:1200",
      "shot:boiler",
      "eval:(() => { const interior=window.__tmtWorkshop.engine.services.scene.get('interior'); window.__materialRoomOccluders=interior.occluders; interior.occluders=interior.occluders.filter(box => !(box.min[0]>4 && box.max[0]<6.9 && box.max[1]<4)); })()",
      "wait:600",
      "shot:boiler-no-prop-occluders-diagnostic",
      "eval:window.__tmtWorkshop.engine.services.scene.get('interior').occluders=window.__materialRoomOccluders",
      "eval:window.__materialInspectionLight=window.__tmtWorkshop.engine.services.scene.lights.add({type:'point',position:[3,3,-2.7],color:[.95,.97,1],intensity:24,range:7,castShadow:false})",
      "wait:600",
      "shot:boiler-neutral-light-diagnostic",
      "eval:window.__tmtWorkshop.engine.services.scene.lights.remove(window.__materialInspectionLight)",
      "eval:(() => { const e=window.__tmtWorkshop.engine; e.frame = input => window.__originalWorkshopFrame({...input, camera:{position:[1.5,1.85,.75],target:[5.7,1.25,-.65],up:[0,1,0],fovY:43*Math.PI/180},focus:{world:[5.7,1.25,-.65],distance:4.5,tilt:0}}); })()",
      "wait:1200",
      "shot:lathe",
      "eval:(() => { const interior=window.__tmtWorkshop.engine.services.scene.get('interior'); interior.occluders=interior.occluders.filter(box => !(box.min[0]>4 && box.max[0]<6.9 && box.max[1]<4)); })()",
      "wait:600",
      "shot:lathe-no-prop-occluders-diagnostic",
      "eval:window.__tmtWorkshop.engine.services.scene.get('interior').occluders=window.__materialRoomOccluders",
      "eval:window.__materialInspectionLight=window.__tmtWorkshop.engine.services.scene.lights.add({type:'point',position:[3,3,.2],color:[.95,.97,1],intensity:24,range:7,castShadow:false})",
      "wait:600",
      "shot:lathe-neutral-light-diagnostic",
      "eval:window.__tmtWorkshop.engine.services.scene.lights.remove(window.__materialInspectionLight)",
      "eval:(() => { window.__tmtWorkshop.engine.frame=window.__originalWorkshopFrame; document.querySelector('.ws-overlay').style.visibility='visible'; })()",
      "click:#workshop-back",
      "wait:400",
      "eval@disposeFirst:({ready:window.__workshopCaptureRuns[0].ready,vram:window.__workshopCaptureRuns[0].engine.telemetry().vram})",
      "click:#title-workshop",
      "waitfor:window.__tmtWorkshop?.ready && !document.querySelector('.ws-loading')",
      "wait:400",
      "eval:window.__workshopCaptureRuns.push(window.__tmtWorkshop)",
      "eval@secondEntry:window.__tmtWorkshop.snapshot()",
      "click:#workshop-back",
      "wait:400",
      "click:#title-workshop",
      "waitfor:window.__tmtWorkshop?.ready && !document.querySelector('.ws-loading')",
      "wait:400",
      "eval:window.__workshopCaptureRuns.push(window.__tmtWorkshop)",
      "eval@thirdEntry:window.__tmtWorkshop.snapshot()",
      "click:#workshop-back",
      "wait:400",
      "eval@disposed:window.__workshopCaptureRuns.map(run => ({ready:run.ready,vram:run.engine.telemetry().vram}))",
      "eval@cleanupAssert:(() => { const runs=window.__workshopCaptureRuns; if(runs.some(run => run.ready || run.engine.telemetry().vram.total !== 0)) throw new Error('Workshop GPU resources retained after disposal'); return {passes:3,allReleased:true}; })()"
    ]
  }]
}
