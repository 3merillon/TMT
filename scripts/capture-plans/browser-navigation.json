{
  "name": "browser-navigation",
  "out": "artifacts/screens/browser-navigation",
  "jobs": [
    {
      "name": "menus-and-campaign",
      "url": "/play.html",
      "wait": "js:!!window.__tmtGame?.ui",
      "timeout": 120000,
      "keys": [
        "click:#title-campaign",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"title\"",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "click:#mission-p1",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "hold:KeyW:2600",
        "waitfor:window.__tmtGame.mission.checkpointStorage === \"saved\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "eval:window.navTick=window.__tmtGame.tick; window.navKey=window.__tmtGame.ui.game",
        "wait:900",
        "eval:if (!(window.__tmtGame.tick === window.navTick)) throw new Error(\"Paused simulation advanced\")",
        "click:#pause-settings",
        "waitfor:window.__tmtGame?.ui.screen === \"settings\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-resume",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "eval:window.navTick=window.__tmtGame.tick",
        "wait:600",
        "eval:if (!(window.__tmtGame.tick===window.navTick)) throw new Error(\"Menu simulation advanced\")",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "eval:if (!(window.__tmtGame.tick===window.navTick && window.__tmtGame.ui.game===window.navKey)) throw new Error(\"Forward created a new session\")",
        "click:#pause-resume",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-settings",
        "waitfor:window.__tmtGame?.ui.screen === \"settings\"",
        "eval:sessionStorage.setItem(\"navExpected\",JSON.stringify({game:window.__tmtGame.ui.game,length:history.length,beat:window.__tmtGame.mission.checkpoint}))",
        "reload",
        "waitfor:window.__tmtGame?.ui.screen === \"settings\"",
        "eval:if (!(window.__tmtGame.ui.game===JSON.parse(sessionStorage.navExpected).game && history.length===JSON.parse(sessionStorage.navExpected).length)) throw new Error(\"Reload grew history or lost game\")",
        "click:#settings-back",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-leave",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-resume",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "shot:resumed",
        "eval@navigation:window.__tmtGame.ui"
      ]
    },
    {
      "name": "cancel-load",
      "url": "/play.html?screen=campaign",
      "wait": "js:!!window.__tmtGame?.ui",
      "timeout": 120000,
      "keys": [
        "eval:document.querySelector(\"#mission-p1\").click(); history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "wait:6000",
        "eval:if (!(window.__tmtGame.ui.screen === \"campaign\")) throw new Error(\"Canceled load returned to match\")",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-resume",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "eval@navigation:window.__tmtGame.ui"
      ]
    },
    {
      "name": "forfeit-and-restart",
      "url": "/play.html?mode=bot&seed=7",
      "wait": "game",
      "timeout": 120000,
      "keys": [
        "eval:window.initialLength=history.length; history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-forfeit",
        "waitfor:window.__tmtGame?.ui.screen === \"results\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"skirmish\"",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"results\"",
        "eval:if (!(window.__tmtGame.ready === false)) throw new Error(\"Forfeit resurrected live simulation\")",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"results\"",
        "click:#results-retry",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "eval:if (!(history.length <= window.initialLength)) throw new Error(\"Retry grew history\")",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"skirmish\"",
        "eval@navigation:window.__tmtGame.ui",
        "shot:finished"
      ]
    },
    {
      "name": "workshop-and-playground",
      "url": "/play.html",
      "wait": "js:!!window.__tmtGame?.ui",
      "timeout": 120000,
      "keys": [
        "click:#title-campaign",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "eval:Array.from(document.querySelectorAll(\"#campaign button\")).find(b=>b.textContent === \"Workshop\").click()",
        "waitfor:window.__tmtGame?.ui.screen === \"workshop\"",
        "wait:4000",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"campaign\"",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"title\"",
        "click:#title-engine-dev",
        "waitfor:window.__tmtGame?.ui.screen === \"match\"",
        "waitfor:!!document.querySelector(\".dev-panel.engine-playground\")",
        "eval:history.back()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "click:#pause-leave",
        "waitfor:window.__tmtGame?.ui.screen === \"title\"",
        "eval:history.forward()",
        "waitfor:window.__tmtGame?.ui.screen === \"pause\"",
        "shot:playground-pause"
      ]
    }
  ]
}