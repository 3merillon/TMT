{
  "name": "workshop-startup", "out": "artifacts/workshop-startup",
  "jobs": [{
    "name": "startup", "url": "/play.html", "size": "1920x1080", "wait": "selector:#title-workshop", "timeout": 120000,
    "settle": 100, "probe": "window.__tmtWorkshop?.snapshot()",
    "keys": [
      "eval:performance.setResourceTimingBufferSize(4000);performance.clearResourceTimings();window.__workshopColdStart=performance.now()",
      "click:#title-workshop",
      "waitfor:window.__tmtWorkshop?.ready && window.__tmtWorkshop.frames>2 && !document.querySelector('.ws-loading')",
      "eval@coldStart:(()=>{const assets=performance.getEntriesByType('resource').filter(e=>e.name.includes('/workshop/')&&!e.name.includes('/src/'));return{interactiveMs:performance.now()-window.__workshopColdStart,assets:assets.length,transferBytes:assets.reduce((n,e)=>n+e.transferSize,0),encodedBytes:assets.reduce((n,e)=>n+e.encodedBodySize,0),decodedBytes:assets.reduce((n,e)=>n+e.decodedBodySize,0)};})()",
      "wait:1800", "shot:hero",
      "eval@shaderCheck:window.__tmtWorkshop.shaderCheck()",
      "click:#workshop-back", "wait:300",
      "eval@disposed:(()=>{const p=window.__tmtWorkshop,b=p.engine.telemetry().vram.total;if(p.ready||b!==0)throw new Error('Resources retained:'+b);return{remainingGpuBytes:b};})()"
    ]
  }]
}
