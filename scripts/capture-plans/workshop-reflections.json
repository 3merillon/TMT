{
  "name": "workshop-reflections", "out": "artifacts/workshop-reflections",
  "jobs": [{
    "name": "reflections", "url": "/play.html", "size": "1920x1080", "wait": "selector:#title-workshop", "timeout": 120000,
    "settle": 100, "probe": "window.__tmtWorkshop?.snapshot()",
    "keys": [
      "click:#title-workshop", "waitfor:window.__tmtWorkshop?.ready && !document.querySelector('.ws-loading')", "wait:1800",
      "eval@shaderCheck:window.__tmtWorkshop.shaderCheck()",
      "eval@probe:(()=>{const p=window.__tmtWorkshop.engine.services.scene.get('interior').reflection;if(!p||p.mips<6)throw new Error('Room HDR reflection probe missing');return p;})()",
      "shot:hero",
      "eval:(()=>{document.querySelector('.ws-overlay').style.visibility='hidden';document.querySelector('.ws-lift-controls').style.visibility='hidden';const e=window.__tmtWorkshop.engine;window.__originalWorkshopFrame=e.frame.bind(e);e.frame=input=>window.__originalWorkshopFrame({...input,camera:{position:[1.8,2.15,3],target:[0,1.5,.9],up:[0,1,0],fovY:40*Math.PI/180},focus:{world:[0,1.5,.9],distance:2.9,tilt:0}});})()",
      "wait:1200", "shot:barrel-probe-on",
      "eval:window.__savedProbeIntensity=window.__tmtWorkshop.engine.services.scene.get('interior').reflection.intensity;window.__tmtWorkshop.engine.services.scene.get('interior').reflection.intensity=0",
      "wait:900", "shot:barrel-probe-off-diagnostic",
      "eval:window.__tmtWorkshop.engine.services.scene.get('interior').reflection.intensity=window.__savedProbeIntensity",
      "eval:window.__tmtWorkshop.engine.frame=input=>window.__originalWorkshopFrame({...input,camera:{position:[-.35,1.8,-.7],target:[-2.65,1.3,-1],up:[0,1,0],fovY:47*Math.PI/180},focus:{world:[-2.65,1.3,-1],distance:2.4,tilt:0}})",
      "wait:1200", "shot:robot-room-reflections",
      "eval:window.__tmtWorkshop.engine.frame=input=>window.__originalWorkshopFrame({...input,camera:{position:[-1.7,2.5,1.3],target:[-5.3,1.4,-4.8],up:[0,1,0],fovY:52*Math.PI/180},focus:{world:[-5.3,1.4,-4.8],distance:6.6,tilt:0}})",
      "wait:900", "shot:compressor-and-crates",
      "eval:window.__tmtWorkshop.engine.frame=input=>window.__originalWorkshopFrame({...input,camera:{position:[0,4.35,-4],target:[0,4.22,-8.62],up:[0,1,0],fovY:45*Math.PI/180},focus:{world:[0,4.22,-8.62],distance:4.6,tilt:0}})",
      "wait:900", "shot:fan-reflections",
      "eval:(()=>{window.__tmtWorkshop.engine.frame=window.__originalWorkshopFrame;document.querySelector('.ws-overlay').style.visibility='visible';document.querySelector('.ws-lift-controls').style.visibility='visible';})()",
      "click:#workshop-back", "wait:300",
      "eval@disposed:(()=>{const p=window.__tmtWorkshop,b=p.engine.telemetry().vram.total;if(p.ready||b!==0)throw new Error('Reflection resources retained:'+b);return{remainingGpuBytes:b};})()"
    ]
  }]
}
