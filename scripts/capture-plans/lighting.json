{
  "name": "lighting",
  "description": "Renderer look-scene captures for temperate, glacial, dune and volcanic planets at 1920x1080, covering camera distances 6/17/36, overview, contact/crater views, orbit shimmer and a terrain commit. The budget checks shadow contact/acne, grounding, crater self-shadow, sky/terminator, bloom and differences between planet kinds. With --perf --gpu-timings --repeat 3 --min, per-pass values come from GPU timestamp medians over 120 captured frames (__tmtLook.gpuMedians). Medians remain sensitive to GPU contention and clock changes: compare under controlled, serialized conditions. The performance job adds a separately timed synthetic load (?load=6) and camera spin to exercise sky-view updates; it is a renderer diagnostic, not a full gameplay benchmark.",
  "out": "artifacts/screens/lighting",
  "budget": "budgets/lighting.json",
  "jobs": [
    {
      "name": "lighting-temperate",
      "url": "/dev/engine-sandbox.html?scene=look&planet=temperate",
      "wait": "js:window.__tmtEngineSandbox?.ready===true",
      "size": "1920x1080",
      "keys": [
        "wait:2500",
        "eval@tank:window.__tmtLook.tankShadow()",
        "eval@acne:window.__tmtLook.acne()",
        "shot:day",
        "eval:window.__tmtEngineSandbox.setCamera('boom6')",
        "wait:1200",
        "shot:boom6",
        "eval:window.__tmtEngineSandbox.setCamera('boom17')",
        "wait:1200",
        "shot:boom17",
        "eval:window.__tmtEngineSandbox.setCamera('boom36')",
        "wait:1200",
        "shot:boom36",
        "eval:window.__tmtEngineSandbox.setCamera('overview')",
        "wait:2500",
        "eval@term:window.__tmtLook.terminator()",
        "shot:overview",
        "eval:window.__tmtEngineSandbox.setCamera('contact')",
        "wait:1500",
        "shot:contact",
        "eval:window.__tmtEngineSandbox.setCamera('crater')",
        "wait:1500",
        "shot:crater",
        "eval@shimmer:window.__tmtLook.shimmer(16)",
        "eval:window.__tmtEngineSandbox.setCamera('crater')",
        "wait:1500",
        "eval@commit:window.__tmtLook.commit()",
        "wait:600",
        "shot:committed",
        "wait:400",
        "eval@stats:window.__tmtLook.stats()"
      ]
    },
    {
      "name": "lighting-glacial",
      "url": "/dev/engine-sandbox.html?scene=look&planet=glacial",
      "wait": "js:window.__tmtEngineSandbox?.ready===true",
      "size": "1920x1080",
      "keys": [
        "wait:2500",
        "eval@tank:window.__tmtLook.tankShadow()",
        "eval@acne:window.__tmtLook.acne()",
        "shot:day",
        "eval:window.__tmtEngineSandbox.setCamera('boom6')",
        "wait:1200",
        "shot:boom6",
        "eval:window.__tmtEngineSandbox.setCamera('boom17')",
        "wait:1200",
        "shot:boom17",
        "eval:window.__tmtEngineSandbox.setCamera('boom36')",
        "wait:1200",
        "shot:boom36",
        "eval:window.__tmtEngineSandbox.setCamera('overview')",
        "wait:2500",
        "eval@term:window.__tmtLook.terminator()",
        "shot:overview"
      ]
    },
    {
      "name": "lighting-dune",
      "url": "/dev/engine-sandbox.html?scene=look&planet=dune",
      "wait": "js:window.__tmtEngineSandbox?.ready===true",
      "size": "1920x1080",
      "keys": [
        "wait:2500",
        "eval@tank:window.__tmtLook.tankShadow()",
        "eval@acne:window.__tmtLook.acne()",
        "shot:day",
        "eval:window.__tmtEngineSandbox.setCamera('boom6')",
        "wait:1200",
        "shot:boom6",
        "eval:window.__tmtEngineSandbox.setCamera('boom17')",
        "wait:1200",
        "shot:boom17",
        "eval:window.__tmtEngineSandbox.setCamera('boom36')",
        "wait:1200",
        "shot:boom36",
        "eval:window.__tmtEngineSandbox.setCamera('overview')",
        "wait:2500",
        "eval@term:window.__tmtLook.terminator()",
        "shot:overview"
      ]
    },
    {
      "name": "lighting-volcanic",
      "url": "/dev/engine-sandbox.html?scene=look&planet=volcanic",
      "wait": "js:window.__tmtEngineSandbox?.ready===true",
      "size": "1920x1080",
      "keys": [
        "wait:2500",
        "eval@tank:window.__tmtLook.tankShadow()",
        "eval@acne:window.__tmtLook.acne()",
        "shot:day",
        "eval:window.__tmtEngineSandbox.setCamera('boom6')",
        "wait:1200",
        "shot:boom6",
        "eval:window.__tmtEngineSandbox.setCamera('boom17')",
        "wait:1200",
        "shot:boom17",
        "eval:window.__tmtEngineSandbox.setCamera('boom36')",
        "wait:1200",
        "shot:boom36",
        "eval:window.__tmtEngineSandbox.setCamera('overview')",
        "wait:2500",
        "eval@term:window.__tmtLook.terminator()",
        "shot:overview"
      ]
    },
    {
      "name": "lighting-perf",
      "url": "/dev/engine-sandbox.html?scene=look&planet=temperate&spin=0.05&load=6",
      "wait": "js:window.__tmtEngineSandbox?.ready===true",
      "size": "1920x1080",
      "keys": [
        "wait:3000",
        "eval@gpu_day:window.__tmtLook.gpuMedians(120)",
        "shot:day",
        "eval:window.__tmtEngineSandbox.setCamera('boom6')",
        "wait:1500",
        "eval@gpu_boom6:window.__tmtLook.gpuMedians(120)",
        "shot:boom6",
        "eval:window.__tmtEngineSandbox.setCamera('crater')",
        "wait:1500",
        "eval@gpu_crater:window.__tmtLook.gpuMedians(120)",
        "shot:crater",
        "eval:window.__tmtEngineSandbox.setCamera('overview')",
        "wait:1500",
        "eval@gpu_overview:window.__tmtLook.gpuMedians(120)",
        "shot:overview"
      ]
    }
  ]
}
