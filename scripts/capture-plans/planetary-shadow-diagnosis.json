{
  "name": "planetary-shadow-diagnosis",
  "out": "artifacts/planetary-lighting/shadow-diagnosis",
  "jobs": [
    {
      "probe": "({game:window.__tmtGame,render:window.__tmtVisuals.telemetry(),settings:window.__tmtVisuals.settings(),camera:window.__tmtVisuals.camera(),sun:window.__tmtVisuals.scene().get(\"sun\"),planet:window.__tmtVisuals.scene().get(\"planet\"),dayOffset:window.__tmtVisuals.dayOffset()})",
      "size": "1600x1000",
      "keys": [
        "eval:import(\"/src/game/app/hooks.ts\").then(m=>m.registerHooks(\"shadow-freeze\",{timeScale:()=>0}))",
        "eval:window.__fixedTime=42; window.__tmtVisuals.setDayOffset((window.__fixedTime-window.__tmtGame.snapshot.time)/480)",
        "eval:import(\"/src/game/meta/settings.ts\").then(m=>m.dispatchSettings({...m.currentSettings(),graphics:{...m.currentSettings().graphics,grassDensity:0}}))",
        "eval:window.__tmtFluids.lookAt(window.__tmtVisuals.tank(),3,7,3.14)",
        "eval:[...document.querySelectorAll('.dev-views button')].find(b=>b.textContent==='Final').click()",
        "wait:700",
        "shot:3.14-final",
        "eval:[...document.querySelectorAll('.dev-views button')].find(b=>b.textContent==='Sun shadow').click()",
        "wait:500",
        "shot:3.14-Sun shadow",
