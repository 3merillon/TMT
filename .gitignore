# No trailing slash: in a worktree node_modules is a directory junction, which git can see as a file.
node_modules
dist/
dist-hub/
artifacts/
*.log
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
public/wasm/
artifacts/screens/
# Per-checkout Vite optimizer cache of scripts/capture.ts, and the verify:bundle output.
.vite-capture/
.verify-dist/
# Cargo output is reproducible; shipped WASM binaries under src/ remain versioned.
target/
# Local agent scratch, asset working sessions, profiles, and recordings.
.gear-work/
.kilo/
.kilocode/
.claude/
.tmp/
tmp/
scratch/
*.cpuprofile
*.heapsnapshot
# Video is not part of the game's media package. Add licensed media through the budget gate.
*.mp4
*.webm
*.mov
*.m4v
*.avi
*.mkv
